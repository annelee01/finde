# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Django ---
DEBUG=True
DJANGO_SECRET_KEY=changeme-generate-a-random-secret-key
ADMIN_USERNAME=admin
MY_DEV_IP=

# --- Database ---
# Either set DB_* (used locally/Docker) or DATABASE_URL (used on platforms like Railway)
DB_ENGINE=django.db.backends.mysql
DB_NAME=mydatabase
DB_USER=user
DB_PASSWORD=changeme
DB_HOST=db
DB_PORT=3306
DATABASE_URL=
RDS_CA_CERT=

# --- Email ---
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=changeme
EMAIL_HOST_PASSWORD=changeme
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=hello@example.com

# --- AWS (S3 media storage) ---
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_REGION=us-east-2

# --- OpenSearch ---
# OPENSEARCH_USE_AWS=True signs requests for AWS-managed OpenSearch (HTTPS + SigV4).
# Set it to False for a local node (docker-compose does this for you).
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_AWS=False

# --- Redis (cache, rate limiting) ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Logging ---
# Set to DEBUG to see size-parsing and search diagnostics
LOG_LEVEL=INFO

# --- reCAPTCHA ---
RECAPTCHA_SECRET_KEY=changeme

# --- Anthropic (Claude Vision, used for garment classification) ---
ANTHROPIC_API_KEY=changeme

# --- eBay API ---
# Set EBAY_ENV to "sandbox" or "production"
EBAY_ENV=sandbox

EBAY_SANDBOX_APP_ID=changeme
EBAY_SANDBOX_CERT_ID=changeme
EBAY_SANDBOX_DEV_ID=changeme
EBAY_SANDBOX_REDIRECT_URI=changeme

EBAY_PROD_APP_ID=changeme
EBAY_PROD_CERT_ID=changeme
EBAY_PROD_DEV_ID=changeme
EBAY_PROD_REDIRECT_URI=changeme

# --- Railway (auto-injected on Railway, leave blank locally) ---
RAILWAY_ENVIRONMENT=
RAILWAY_PUBLIC_DOMAIN=
